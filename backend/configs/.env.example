HF_TOKEN="YOUR_HF_TOKEN FOR DIARIZATION MODEL (READ PERMISSION)"

# Database (read at process import — must be set before uvicorn starts)
DB_URL="postgresql+psycopg2://whizzper:whizzper@127.0.0.1:5432/whizzper"
# DB_URL="sqlite:///backend/records.db"

# Redis (required for batch/single transcription enqueue — Celery broker)
REDIS_URL="redis://localhost:6379/0"

# Celery workers (separate Railway service — see scripts/start_workers.sh)
# CELERY_DOWNLOAD_CONCURRENCY=4
# CELERY_TRANSCRIBE_CONCURRENCY=16
# CELERY_TASK_TIME_LIMIT=7200
# CELERY_TASK_SOFT_TIME_LIMIT=6900
# CELERY_VISIBILITY_TIMEOUT=10800
# BATCH_MAX_FILES=500
# BATCH_FANOUT_CHUNK_SIZE=25
# ORCHESTRATOR_RESCHEDULE_SECONDS=10
# STUCK_TASK_MINUTES=30
# CACHE_TTL_SECONDS=86400

# Modal GPU inference (preferred local dev mode on CPU VMs)
MODAL_WEB_ENDPOINT_URL="https://your-modal-endpoint.modal.run"
# MODAL_ENDPOINTS="https://ep1.modal.run,https://ep2.modal.run"

# Google OAuth for Drive integration
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
DRIVE_TOKEN_ENC_KEY=""
DRIVE_OWNER_KEY="interim-owner"

# Optional security
# WHIZZPER_API_KEY=""  # When set, share-token create/revoke require X-API-Key header
# CORS_ORIGINS="http://localhost:8000,http://localhost:5173"

# Public HTTPS origin for Google Translate share links when dev server is accessed via localhost
# PUBLIC_APP_URL="https://your-subdomain.trycloudflare.com"

# Destructive DB rebuild on schema mismatch (dev only — never in production)
# ALLOW_DB_REBUILD=true

# Observability
# SENTRY_DSN=""
# PUBLIC_APP_URL for translate proxy (see above)

# Batch processing (legacy in-process — use Celery workers instead)
# BATCH_MAX_CONCURRENCY=8

# Modal pool tuning (2 endpoints × POOL_PER_ENDPOINT_CAP=8 → 16 parallel GPU jobs)
# POOL_PER_ENDPOINT_CAP=8
# POOL_UNHEALTHY_THRESHOLD=3
# POOL_COOLDOWN_SECONDS=60
# POOL_MAX_RETRIES=2
